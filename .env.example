# ─── LOOP Sandbox API ────────────────────────────────────────────────────────
# The sandbox is a WSO2 gateway: every API lives under
# https://sandbox.loop.co.ke/gateway/<context>/<version>, and auth is
# machine-to-machine — Basic(Consumer Key:Consumer Secret) returns a Bearer
# token. There is no user login or consent screen in LOOP's API.
#
# Generate the pair at: Developer Portal -> Application -> Sandbox Keys.
# Sandbox only, per hackathon Terms 2.4-2.5.
LOOP_CONSUMER_KEY=your_loop_consumer_key
LOOP_CONSUMER_SECRET=your_loop_consumer_secret

# Optional — only if your portal publishes different paths than these.
# LOOP_GATEWAY_URL=https://sandbox.loop.co.ke/gateway
# LOOP_TOKEN_URL=https://sandbox.loop.co.ke/gateway/auth/1.0/oauth2/token
# LOOP_HISTORY_URL=https://sandbox.loop.co.ke/gateway/transaction-history/1.0.0/services/process-request
# LOOP_PAY_PAYBILL_URL=https://sandbox.loop.co.ke/gateway/pay-to-paybill/1.0/services/process-request

# Instant Payment Notification callback. Requests are HMAC-verified with
# LOOP_IPN_SECRET, falling back to the consumer secret.
LOOP_IPN_CALLBACK_URL=http://localhost:3000/api/loop/ipn
# LOOP_IPN_SECRET=

# ─── Standing orders (scheduled runner) ──────────────────────────────────────
# The cron endpoint initiates payments, so it refuses to run unless this is
# set. Generate one the same way as JWT_SECRET. On Vercel, add it as an env var
# and Vercel Cron will send it automatically as a bearer token.
CRON_SECRET=

# Demo mode: when LOOP_CLIENT_ID / LOOP_API_SECRET are missing, Chroma signs in
# against a seeded sandbox account instead of the live sandbox, so the demo
# still runs if the sandbox is rate-limited during judging. Set to "false" to
# hard-require the real LOOP sandbox and fail loudly instead.
LOOP_DEMO_MODE=auto

# ─── App ─────────────────────────────────────────────────────────────────────
# 32+ random chars. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_random_secret
NEXT_PUBLIC_APP_NAME=Chroma
APP_BASE_URL=http://localhost:3000

# ─── AI Insights (optional) ──────────────────────────────────────────────────
# Without a key, Chroma falls back to its deterministic rules engine, so
# insights always render.
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# ─── Database ────────────────────────────────────────────────────────────────
# Unset -> Chroma uses the local file-backed store in ./.data. Fine for
# `npm run dev`, useless once deployed: serverless filesystems are per-instance
# and ephemeral, so Boards and tags would come and go.
#
# Set it -> Chroma uses Postgres/Supabase. REQUIRED for any deployment.
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the CONNECTION POOLER URI (port 6543) for Vercel, not the direct 5432 one.
# Then apply the schema once:  npm run db:push
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
